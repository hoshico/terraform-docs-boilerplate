{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Communication Requirements",
  "type": "object",
  "required": ["network", "resources", "communications"],
  "additionalProperties": false,
  "properties": {
    "network": { "$ref": "#/$defs/network" },
    "resources": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "$ref": "#/$defs/logicalId" },
      "additionalProperties": { "$ref": "#/$defs/resource" }
    },
    "communications": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/communication" }
    }
  },
  "$defs": {
    "logicalId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "cidr": {
      "type": "string",
      "pattern": "^([0-9]{1,3}\\.){3}[0-9]{1,3}/[0-9]{1,2}$"
    },
    "network": {
      "type": "object",
      "required": ["region", "vpc", "availability_zones", "subnets"],
      "additionalProperties": false,
      "properties": {
        "region": { "type": "string", "pattern": "^[a-z]{2}-[a-z]+-[0-9]$" },
        "vpc": {
          "type": "object",
          "required": ["label", "cidr"],
          "additionalProperties": false,
          "properties": {
            "label": { "type": "string", "minLength": 1 },
            "cidr": { "$ref": "#/$defs/cidr" }
          }
        },
        "availability_zones": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z]{2}-[a-z]+-[0-9][a-z]$" }
        },
        "subnets": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/subnet" }
        }
      }
    },
    "subnet": {
      "type": "object",
      "required": ["id", "label", "type", "cidrs"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/logicalId" },
        "label": { "type": "string", "minLength": 1 },
        "type": { "enum": ["public", "private"] },
        "cidrs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/cidr" },
          "description": "availability_zones と同じ順序で指定する"
        }
      }
    },
    "resource": {
      "type": "object",
      "required": ["type", "label"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "pattern": "^(aws_[a-z0-9_]+|users)$",
          "description": "構成図のアイコン判定に使うリソースタイプ"
        },
        "label": { "type": "string", "minLength": 1 },
        "subnet": {
          "$ref": "#/$defs/logicalId",
          "description": "配置先サブネットの id。省略時は VPC 外"
        },
        "layout": {
          "enum": ["single", "span", "per_az", "primary_standby"],
          "description": "AZ への配置方法。省略時は single"
        }
      }
    },
    "communication": {
      "type": "object",
      "required": ["id", "source", "destination", "protocol", "port", "description"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/logicalId" },
        "source": { "$ref": "#/$defs/logicalId" },
        "destination": { "$ref": "#/$defs/logicalId" },
        "protocol": { "enum": ["tcp", "udp"] },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "description": { "type": "string", "minLength": 1 }
      }
    }
  }
}
